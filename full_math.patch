    const sbState = window as any;
    sbState["sb_segments"] = [];
    sbState["sb_is_seeking"] = false;

    // Map logical time to physical time
    function getPhysicalTime(logicalTime: number): number {
        let physicalTime = logicalTime;
        for (const segment of sbState["sb_segments"]) {
            if (logicalTime >= segment[0]) {
                const skipDuration = segment[1] - segment[0];
                physicalTime += skipDuration;
            }
        }
        return physicalTime;
    }

    // Map physical time back to logical time
    function getLogicalTime(physicalTime: number): number {
        let logicalTime = physicalTime;
        for (const segment of sbState["sb_segments"]) {
            if (physicalTime >= segment[1]) {
                const skipDuration = segment[1] - segment[0];
                logicalTime -= skipDuration;
            } else if (physicalTime >= segment[0] && physicalTime < segment[1]) {
                // Inside a segment, map to segment start
                return segment[0] - (sbState["sb_segments"].filter(s => s[0] < segment[0]).reduce((acc, s) => acc + (s[1] - s[0]), 0));
            }
        }
        return logicalTime;
    }

